{
  "name": "chrome-pet",
  "version": "0.3.0",
  "description": "크롬 확장프로그램용 펫 키우기 프로젝트",
  "main": "index.js",
  "scripts": {
    "build": "vite build && vite build --config vite.background.config.ts && vite build --config vite.popup.config.ts",
    "dev": "vite build --watch",
    "dev:popup": "vite build --watch --config vite.popup.config.ts",
    "dev:background": "vite build --watch --config vite.background.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimddon/chrome-pet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mimddon/chrome-pet/issues"
  },
  "homepage": "https://github.com/mimddon/chrome-pet#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
